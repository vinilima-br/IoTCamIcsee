# .bat e .ps1 precisam de quebra de linha do Windows (CRLF), inclusive no ZIP
# baixado pelo bootstrap.bat - senao o cmd quebra comandos de varias linhas.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# O bootstrap.bat e baixado pelo link "raw" do GitHub, que entrega o arquivo
# do jeito que esta guardado no repositorio. Com -text o git guarda os bytes
# como estao (CRLF) e o link entrega CRLF. O ENVIAR_PARA_GITHUB.bat faz o
# renormalize que aplica isso.
bootstrap.bat -text

# Fora do ZIP que os PCs baixam (bootstrap.bat e atualizacao automatica):
# so o PC de desenvolvimento (com git) precisa destas pastas.
/dev export-ignore
/docs export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
